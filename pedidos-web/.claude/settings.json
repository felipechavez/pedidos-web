{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(legado/**)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(iwr:*)",
      "PowerShell(curl:*)",
      "PowerShell(wget:*)",
      "WebFetch",
      "Edit(**/migracion/golden-master.csv)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardian.sh\"", "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && dotnet test --nologo 1>&2 || exit 2" }
        ]
      }
    ]
  }
}
